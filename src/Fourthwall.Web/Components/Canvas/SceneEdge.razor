@* A link's line on the pencil map: a pencil curve for a choice, the same curve in leader dots for a
   follow-up (docs/design/0002-visual-direction.md §10.3). Its label is SceneEdgeLabel, drawn in a
   layer above every line. *@
<g class="canvas-edge @(IsChoice ? "edge-choice" : "edge-follow-up")">
    @if (IsChoice)
    {
        <title>@Edge.Label</title>
    }

    <path class="edge-line" d="@Edge.PathData" marker-end="url(#canvas-arrow)" />
</g>
