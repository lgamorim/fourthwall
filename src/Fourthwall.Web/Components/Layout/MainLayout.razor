@inherits LayoutComponentBase

<header class="app-header">
    <span class="app-name">Fourthwall</span>

    @if (Workspace.Current is not null)
    {
        <span class="story-title">@Workspace.Current.Title</span>
        <button id="close-story" class="app-header-action" @onclick="CloseAsync">Close story</button>
    }
</header>

<div class="app-shell">
    <main class="app-main">
        @Body
    </main>

    @* The dock holds the scene inspector (M13) and the validation panel (M16). *@
    <aside class="app-dock" aria-label="Inspector"></aside>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
