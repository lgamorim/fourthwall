<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fourthwall is a locally-hosted application (the Web project is the deliverable and is not
       packable), not a library published to nuget.org; its Infrastructure package rides the
       first-party SqlBound release-candidate by design. So NU5104 (a stable package should not have
       a prerelease dependency), which fires once the phase-closing version drops to a clean X.Y.0,
       is expected here rather than a packaging bug, and stays suppressed until SqlBound ships a
       stable release. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Graph1x" />
    <PackageReference Include="SqlBound" />
    <PackageReference Include="SqlBound.Generators" PrivateAssets="all" />
    <PackageReference Include="SqlBound.Migrations" />
    <PackageReference Include="SqlBound.Sqlite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fourthwall.Application\Fourthwall.Application.csproj" />
  </ItemGroup>

  <!-- SQL-file migrations are read from a directory at runtime by SqlBound's
       MigrationDirectory.Load. Copy them beside the assembly (and into every
       dependent's output) so StoryDatabaseMigrator can resolve them via
       AppContext.BaseDirectory. -->
  <ItemGroup>
    <Content Include="Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>

</Project>
