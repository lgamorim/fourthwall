<Project>

  <!-- Shared MSBuild properties for every project in the repository.
       Individual .csproj files stay minimal and inherit from here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Zero-warning bar: style violations and warnings fail the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Required for IDE0005 (unused usings) to run at build time; also enables
         CS1591 so missing XML docs on public members are enforced (coding standard).
         Suppressed for non-API surfaces (Web components, tests) via .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package version for `dotnet pack`. Prerelease suffix during a phase's
       active development; the phase-closing commit drops it to the clean X.Y.0.
       Phase 4 (Interactive Canvas) is complete: this commit closes it at 0.4.0
       and is tagged v0.4.0, so the tag matches the version it marks exactly.
       Phase 5's first commit starts the 0.5.0-preview line at preview.1, and the
       preview number advances once per milestone in that milestone's first
       commit. -->
  <PropertyGroup>
    <Version>0.4.0</Version>
  </PropertyGroup>

</Project>
