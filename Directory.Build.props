<Project>

  <!-- Shared MSBuild properties for every project in the repository.
       Individual .csproj files stay minimal and inherit from here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Zero-warning bar: style violations and warnings fail the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Required for IDE0005 (unused usings) to run at build time; also enables
         CS1591 so missing XML docs on public members are enforced (coding standard).
         Suppressed for non-API surfaces (Web components, tests) via .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package version for `dotnet pack`. Prerelease suffix during a phase's
       active development; the phase-closing commit drops it to the clean X.Y.0.
       Phase 4 (Interactive Canvas) is in progress on the 0.4.0-preview line, and
       the preview number advances once per milestone in that milestone's first
       commit (preview.3 is M19). The closing commit drops the suffix to 0.4.0 and
       is tagged v0.4.0, so the tag always matches the version it marks exactly. -->
  <PropertyGroup>
    <Version>0.4.0-preview.3</Version>
  </PropertyGroup>

</Project>
